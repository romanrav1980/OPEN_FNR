<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="source_batch_publication_definitions" targetNamespace="https://open-fnr/processes/data-ingestion">
  <bpmn:process id="source_batch_publication_process" name="Source Batch Publication Process" isExecutable="true">
    <bpmn:startEvent id="start_batch_arrived" name="Source batch arrived" />
    <bpmn:serviceTask id="load_manifest" name="Load source manifest" />
    <bpmn:serviceTask id="discover_source_files" name="Discover source files" />
    <bpmn:serviceTask id="validate_schema" name="Validate source schema" />
    <bpmn:serviceTask id="validate_counts_checksum" name="Validate row count and checksum" />
    <bpmn:businessRuleTask id="evaluate_source_batch_gate" name="Evaluate source batch gate" />
    <bpmn:exclusiveGateway id="source_batch_accepted_gateway" name="Source batch accepted?" />
    <bpmn:serviceTask id="publish_clean_canonical" name="Publish clean canonical tables" />
    <bpmn:serviceTask id="write_lineage" name="Write source lineage" />
    <bpmn:serviceTask id="write_publication_audit" name="Write publication audit" />
    <bpmn:userTask id="review_source_batch_blocker" name="Review source batch blocker" />
    <bpmn:userTask id="approve_reprocessing" name="Approve source reprocessing" />
    <bpmn:serviceTask id="open_recovery_case" name="Open source batch recovery case" />
    <bpmn:endEvent id="end_published" name="Clean data published" />
    <bpmn:endEvent id="end_blocked" name="Source batch blocked" />
    <bpmn:sequenceFlow id="flow_start_to_manifest" sourceRef="start_batch_arrived" targetRef="load_manifest" />
    <bpmn:sequenceFlow id="flow_manifest_to_discovery" sourceRef="load_manifest" targetRef="discover_source_files" />
    <bpmn:sequenceFlow id="flow_discovery_to_schema" sourceRef="discover_source_files" targetRef="validate_schema" />
    <bpmn:sequenceFlow id="flow_schema_to_counts" sourceRef="validate_schema" targetRef="validate_counts_checksum" />
    <bpmn:sequenceFlow id="flow_counts_to_gate" sourceRef="validate_counts_checksum" targetRef="evaluate_source_batch_gate" />
    <bpmn:sequenceFlow id="flow_gate_to_decision" sourceRef="evaluate_source_batch_gate" targetRef="source_batch_accepted_gateway" />
    <bpmn:sequenceFlow id="flow_decision_to_publish" sourceRef="source_batch_accepted_gateway" targetRef="publish_clean_canonical" />
    <bpmn:sequenceFlow id="flow_decision_to_review" sourceRef="source_batch_accepted_gateway" targetRef="review_source_batch_blocker" />
    <bpmn:sequenceFlow id="flow_publish_to_lineage" sourceRef="publish_clean_canonical" targetRef="write_lineage" />
    <bpmn:sequenceFlow id="flow_lineage_to_audit" sourceRef="write_lineage" targetRef="write_publication_audit" />
    <bpmn:sequenceFlow id="flow_audit_to_published" sourceRef="write_publication_audit" targetRef="end_published" />
    <bpmn:sequenceFlow id="flow_review_to_approval" sourceRef="review_source_batch_blocker" targetRef="approve_reprocessing" />
    <bpmn:sequenceFlow id="flow_approval_to_recovery_case" sourceRef="approve_reprocessing" targetRef="open_recovery_case" />
    <bpmn:sequenceFlow id="flow_recovery_case_to_blocked" sourceRef="open_recovery_case" targetRef="end_blocked" />
  </bpmn:process>
</bpmn:definitions>
